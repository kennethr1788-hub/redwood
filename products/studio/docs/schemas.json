{
  "studio": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
      },
      "asset": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^media\\/original\\.(mp4|mov|webm|mkv)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 4320
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 120000
          },
          "hasAudio": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "width",
          "height",
          "durationMs",
          "hasAudio"
        ],
        "additionalProperties": false
      },
      "input": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "import",
              "url"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "schemaVersion",
      "id",
      "name",
      "createdAt",
      "asset",
      "input",
      "revision"
    ],
    "additionalProperties": false
  },
  "timeline": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "trim": {
        "type": "object",
        "properties": {
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120000
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120000
          }
        },
        "required": [
          "startMs",
          "endMs"
        ],
        "additionalProperties": false
      },
      "title": {
        "type": "string",
        "maxLength": 100
      },
      "subtitle": {
        "type": "string",
        "maxLength": 160
      },
      "theme": {
        "type": "string",
        "enum": [
          "aurora",
          "midnight",
          "ember"
        ]
      },
      "zoom": {
        "type": "number",
        "minimum": 1,
        "maximum": 2
      },
      "focus": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "captions": {
        "maxItems": 40,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120000
            },
            "endMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 120000
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          },
          "required": [
            "startMs",
            "endMs",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "cursor": {
        "type": "boolean"
      }
    },
    "required": [
      "schemaVersion",
      "trim",
      "title",
      "subtitle",
      "theme",
      "zoom",
      "focus",
      "captions",
      "cursor"
    ],
    "additionalProperties": false
  }
}
